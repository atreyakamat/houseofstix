{
  "name": "houseofstix",
  "version": "0.1.0",
  "private": true,
  "description": "House of Stix: the control room. One dashboard to open, watch and operate every Stix tool.",
  "scripts": {
    "dev": "next dev -p 8200",
    "build": "next build",
    "start": "next start -p 8200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:stixctl": "bash tests/stixctl/run.sh"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
