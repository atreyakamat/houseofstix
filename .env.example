# Copy to .env and fill in. Never commit .env.

# The password for the control room.
HOUSE_PASSWORD=

# 32+ random characters that sign the login cookie: openssl rand -base64 48
HOUSE_SECRET=

# Address of the machine the tools run on, as your browser sees it
# (used by services.yaml). Default: localhost.
HOME_LAB_HOST=localhost

# Optional: a different services file.
# SERVICES_FILE=/config/services.yaml

# Only set to 1 when a reverse proxy (Caddy, nginx) sits in front and sets
# X-Forwarded-For. Without a proxy leave it empty: the login limiter then can't
# be dodged with a made-up header.
TRUST_PROXY=

# The address the control room listens on (docker-compose.yml). Use the home
# lab's LAN or Tailscale IP to keep it off every other network. Default: all.
HUB_BIND=
