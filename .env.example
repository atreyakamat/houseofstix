# Copy to .env and fill in. Never commit .env.

# The password for the control room.
HOUSE_PASSWORD=

# 32+ random characters that sign the login cookie: openssl rand -base64 48
HOUSE_SECRET=

# Address of the machine the tools run on, as your browser sees it
# (used by services.yaml). Default: localhost.
HOME_LAB_HOST=localhost

# Optional: a different services file.
# SERVICES_FILE=/config/services.yaml
